# Only needed if a notebook/job is started from outside this repo, or from a
# different clone/mount of it (root discovery otherwise walks up from the
# current working directory looking for .git or pyproject.toml).
# DATAPATHS_REPO_ROOT="/home/<user>/WORK/github/dp2_trieste_hands_on"

# Both default to configs/roots.local.yaml and configs/artifacts_registry.yaml
# under the repo root; override only if this project's config files live
# somewhere else on a given machine.
# DATAPATHS_ROOTS_FILE="configs/roots.local.yaml"
# DATAPATHS_REGISTRY_FILE="configs/artifacts_registry.yaml"